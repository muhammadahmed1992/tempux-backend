{
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2020"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2023",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@Module/*": ["src/modules/*"],
      "@Controllers/*": ["src/controllers/*"],
      "@Services/*": ["src/services/*"],
      "@Repository/*": ["src/common/db/*"],
      "@DTO/*": ["src/common/dto/*"],
      "@Helper/*": ["src/common/helper/*"],
      "@Auth/*": ["src/auth/*"],
      "@Brand/*": ["src/brand/*"],
      "@Cart/*": ["src/cart/*"],
      "@Category/*": ["src/category/*"],
      "@Color/*": ["src/color/*"],
      "@CustomFilterConfigurator/*": ["src/custom-filter-configurator/*"],
      "@CustomProductVarientCategory/*": [
        "src/custom-product-varient-category/*"
      ],
      "@GlobalConfiguration/*": ["src/global-configuration/*"],
      "@Favorite/*": ["src/favorite/*"],
      "@Prisma/*": ["src/prisma/*"],
      "@Product/*": ["src/product/*"],
      "@ProductAnalytics/*": ["src/product-analytics/*"],
      "@ProductVariant/*": ["src/product-variant/*"],
      "@Reviews/*": ["src/reviews/*"],
      "@Size/*": ["src/size/*"],
      "@Type/*": ["src/type/*"],
      "@Proxy/*": ["src/proxy/*"],
      "@Decorators/*": ["src/auth/decorators/*"],
      "@HashIds/*": ["src/hash-ids/*"],
      "@Resolvers/*": ["src/common/resolver/*"],
      "@Pipes/*": ["src/common/pipes/*"],
      "@Search/*": ["src/search/*"],
      "@Common/*": ["src/common/*"]
    }
  },
  "include": ["src/**/*.ts", "node_modules/@prisma/client"],
  "exclude": ["dist"]
}
